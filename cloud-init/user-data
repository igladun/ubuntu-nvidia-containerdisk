#cloud-config
package_update: false
package_upgrade: false

bootcmd:
  - [ bash, -lc, "systemctl mask --now fwupd-refresh.service fwupd-refresh.timer fwupd.service || true" ]

write_files:
  - path: /usr/local/sbin/bootstrap-nvidia.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euxo pipefail
      export DEBIAN_FRONTEND=noninteractive

      NVIDIA_DRIVER_BRANCH=580
      # NVIDIA's Ubuntu 24.04 repo publishes this driver as 580.178.04-1ubuntu1: the fixed
      # version from NVIDIA's September 2026 GPU display driver security bulletin (note the
      # -1ubuntu1 packaging suffix, older builds used -0ubuntu1). The Trivy gate does not
      # see NVIDIA driver CVEs at all, so the weekly driver-freshness workflow fails when
      # the repo carries a newer 580.x build than this pin.
      NVIDIA_DRIVER_VERSION=580.178.04-1ubuntu1
      NVIDIA_HEADLESS_PACKAGE="nvidia-headless-${NVIDIA_DRIVER_BRANCH}"
      NVIDIA_UTILS_PACKAGE="nvidia-utils-${NVIDIA_DRIVER_BRANCH}"

      # CUDA 13.0 runtime libraries plus the parts of the dev toolkit that do not drag in
      # Nsight Compute/Systems. The cuda-toolkit-13-0 metapackage pulls cuda-tools ->
      # cuda-visual-tools -> Nsight, whose bundled Go binaries (nic_sampler plugins) carry
      # Go stdlib CVEs that only an NVIDIA rebuild can fix. None of these packages depend
      # on cuda-drivers, so they cannot fight the exact driver pin; libcuda.so still comes
      # from libnvidia-compute-580.
      CUDA_RUNTIME_PACKAGE="cuda-libraries-13-0"
      CUDA_DEV_PACKAGES=(
        cuda-compiler-13-0
        cuda-libraries-dev-13-0
        cuda-command-line-tools-13-0
        cuda-nvml-dev-13-0
      )

      # Kernel metapackages the noble cloud image may ship. They pull the newest noble
      # kernel in during dist-upgrade and are purged right after, so nothing later in the
      # bake (or a consumer VM's unattended-upgrades) can pull a kernel that lacks the
      # NVIDIA module.
      KERNEL_META_CANDIDATES=(
        linux-virtual linux-image-virtual linux-headers-virtual linux-modules-extra-virtual
        linux-generic linux-image-generic linux-headers-generic linux-modules-extra-generic
      )

      retry() {
        for i in 1 2 3 4 5; do
          "$@" && return 0
          sleep 5
        done
        return 1
      }

      append_if_missing() {
        local line="$1"
        local file="$2"
        grep -qxF "$line" "$file" 2>/dev/null || echo "$line" >> "$file"
      }

      # Names from KERNEL_META_CANDIDATES that dpkg reports as installed, one per line.
      installed_kernel_metas() {
        dpkg-query -W -f='${db:Status-Status} ${Package}\n' 'linux-*' 2>/dev/null \
          | awk '$1 == "installed" {print $2}' \
          | grep -Fxf <(printf '%s\n' "${KERNEL_META_CANDIDATES[@]}") || true
      }

      # apt-daily / unattended-upgrades may hold the dpkg lock early in the first boot;
      # wait for it instead of failing. Removed again before the image is sealed.
      echo 'DPkg::Lock::Timeout "300";' > /etc/apt/apt.conf.d/99bake-lock-timeout

      retry apt-get update
      retry apt-get install -y --no-install-recommends ca-certificates curl gnupg

      # Apply every Ubuntu security/updates fix that landed after the cloud image was
      # respun, including the newest noble kernel: the kernel metapackages are still
      # installed at this point, so dist-upgrade pulls the current linux-image-virtual
      # kernel (and its headers) in next to the kernel the cloud image booted. Phased
      # updates are included because the vulnerability gate knows nothing about phasing.
      retry apt-get dist-upgrade -y --no-install-recommends \
        -o APT::Get::Always-Include-Phased-Updates=true

      # The NVIDIA module is built for the newest installed kernel, and that is the only
      # kernel the image keeps. The bake VM itself keeps running the cloud image's kernel;
      # DKMS does not need the target kernel to be the running one.
      RUNNING_KERNEL="$(uname -r)"
      KVER="$(linux-version list | linux-version sort | tail -n1)"
      if [ -z "${KVER}" ] || [ ! -f "/boot/vmlinuz-${KVER}" ] || ! dpkg -s "linux-image-${KVER}" >/dev/null 2>&1; then
        echo "FATAL: could not determine the newest installed kernel (got '${KVER}')"
        exit 1
      fi
      # Version-ABI part of the kernel name (6.8.0-146 for 6.8.0-146-generic); the
      # arch-independent linux-headers-<abi> package carries no flavour suffix.
      KABI="${KVER%-*}"
      echo "Running kernel: ${RUNNING_KERNEL}; building the NVIDIA module for: ${KVER}"
      # Marked manual so the autoremove at the end cannot take it once its metapackage is
      # gone, and held so nothing in the rest of the bake can move it.
      apt-mark manual "linux-image-${KVER}" "linux-modules-${KVER}"
      apt-mark hold "linux-image-${KVER}" "linux-modules-${KVER}"
      # The metapackages have done their job; purge them now so nothing later in the bake
      # can pull yet another kernel.
      KERNEL_METAS="$(installed_kernel_metas)"
      if [ -n "${KERNEL_METAS}" ]; then
        # shellcheck disable=SC2086
        apt-get purge -y ${KERNEL_METAS}
      fi
      # Drop every other kernel's headers before nvidia-dkms is installed: its postinst
      # builds for the running kernel as well as the newest one whenever both have headers,
      # and that second build would cost another half hour for a kernel the image does not
      # keep. Kernels without headers are skipped.
      OTHER_HEADERS="$(dpkg-query -W -f='${db:Status-Status} ${Package}\n' 'linux-headers-*' 2>/dev/null \
        | awk '$1 == "installed" {print $2}' \
        | grep -vE -- "^linux-headers-${KABI}(-|$)" || true)"
      if [ -n "${OTHER_HEADERS}" ]; then
        # shellcheck disable=SC2086
        apt-get purge -y ${OTHER_HEADERS}
      fi

      install -m 0755 -d /usr/share/keyrings
      curl -fsSL --retry 5 --retry-connrefused --retry-delay 2 https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub \
        | gpg --dearmor -o /usr/share/keyrings/nvidia-cuda-archive-keyring.gpg
      cat >/etc/apt/sources.list.d/nvidia-cuda.list <<'EOF'
      deb [signed-by=/usr/share/keyrings/nvidia-cuda-archive-keyring.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/ /
      EOF

      cat >/etc/apt/preferences.d/nvidia-580-pin <<EOF
      Package: nvidia-driver-${NVIDIA_DRIVER_BRANCH} nvidia-headless-${NVIDIA_DRIVER_BRANCH} nvidia-headless-no-dkms-${NVIDIA_DRIVER_BRANCH} nvidia-dkms-${NVIDIA_DRIVER_BRANCH} nvidia-kernel-common-${NVIDIA_DRIVER_BRANCH} nvidia-kernel-source-${NVIDIA_DRIVER_BRANCH} nvidia-utils-${NVIDIA_DRIVER_BRANCH} libnvidia-compute-${NVIDIA_DRIVER_BRANCH} libnvidia-common-${NVIDIA_DRIVER_BRANCH} libnvidia-extra-${NVIDIA_DRIVER_BRANCH} libnvidia-cfg1-${NVIDIA_DRIVER_BRANCH} libnvidia-gl-${NVIDIA_DRIVER_BRANCH} libnvidia-fbc1-${NVIDIA_DRIVER_BRANCH} libnvidia-encode-${NVIDIA_DRIVER_BRANCH} libnvidia-decode-${NVIDIA_DRIVER_BRANCH} libnvidia-gpucomp-${NVIDIA_DRIVER_BRANCH} xserver-xorg-video-nvidia-${NVIDIA_DRIVER_BRANCH}
      Pin: version ${NVIDIA_DRIVER_VERSION}
      Pin-Priority: 1001
      EOF

      retry apt-get update

      EXACT_HEADLESS_DKMS_SPEC="${NVIDIA_HEADLESS_PACKAGE}=${NVIDIA_DRIVER_VERSION}"
      EXACT_UTILS_SPEC="${NVIDIA_UTILS_PACKAGE}=${NVIDIA_DRIVER_VERSION}"
      EXACT_DKMS_SPEC="nvidia-dkms-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"
      EXACT_KERNEL_COMMON_SPEC="nvidia-kernel-common-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"
      EXACT_KERNEL_SOURCE_SPEC="nvidia-kernel-source-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"
      EXACT_FIRMWARE_SPEC="nvidia-firmware-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"
      EXACT_COMPUTE_SPEC="libnvidia-compute-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"
      EXACT_COMMON_SPEC="libnvidia-common-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"
      EXACT_EXTRA_SPEC="libnvidia-extra-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"
      EXACT_GPUCOMP_SPEC="libnvidia-gpucomp-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"
      EXACT_CFG_SPEC="libnvidia-cfg1-${NVIDIA_DRIVER_BRANCH}=${NVIDIA_DRIVER_VERSION}"

      # The NVIDIA kernel module is built with DKMS against the target kernel chosen above
      # (the newest installed one). Ubuntu's prebuilt linux-modules-nvidia-580 packages
      # track a different branch point than the exact version pinned above, so they are
      # deliberately not used.
      retry apt-get install -y --no-install-recommends \
        build-essential dkms "linux-headers-$KVER"
      retry apt-get install -y --no-install-recommends \
        "$EXACT_FIRMWARE_SPEC" \
        "$EXACT_DKMS_SPEC" \
        "$EXACT_KERNEL_COMMON_SPEC" \
        "$EXACT_KERNEL_SOURCE_SPEC" \
        "$EXACT_COMPUTE_SPEC" \
        "$EXACT_COMMON_SPEC" \
        "$EXACT_EXTRA_SPEC" \
        "$EXACT_GPUCOMP_SPEC" \
        "$EXACT_CFG_SPEC" \
        "$EXACT_UTILS_SPEC" \
        "$EXACT_HEADLESS_DKMS_SPEC"

      cat >/etc/modules-load.d/nvidia.conf <<'EOF'
      nvidia
      nvidia_uvm
      nvidia_modeset
      nvidia_drm
      EOF

      cat >/usr/local/sbin/load-nvidia-modules.sh <<'EOF'
      #!/bin/bash
      set -euo pipefail

      if ! grep -qs '^0x10de$' /sys/bus/pci/devices/*/vendor 2>/dev/null && [ ! -c /dev/nvidiactl ]; then
        exit 0
      fi

      for module in nvidia nvidia_uvm nvidia_modeset nvidia_drm; do
        modprobe "$module" || true
      done
      EOF
      chmod 0755 /usr/local/sbin/load-nvidia-modules.sh

      cat >/etc/systemd/system/nvidia-modules-load.service <<'EOF'
      [Unit]
      Description=Load NVIDIA kernel modules when a GPU is present
      After=systemd-modules-load.service local-fs.target
      Before=multi-user.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/load-nvidia-modules.sh

      [Install]
      WantedBy=multi-user.target
      EOF

      append_if_missing "nvidia" /etc/initramfs-tools/modules
      append_if_missing "nvidia_uvm" /etc/initramfs-tools/modules
      append_if_missing "nvidia_modeset" /etc/initramfs-tools/modules
      append_if_missing "nvidia_drm" /etc/initramfs-tools/modules

      dkms autoinstall -k "$KVER" || true
      depmod -a "$KVER" || true
      update-initramfs -u -k "$KVER"
      sync

      # CUDA 13.0 runtime libraries + the Nsight-free dev toolkit (native pairing for
      # driver branch 580). The CUDA apt repo + keyring configured above already provide
      # these packages; they bring nvcc, headers and dev libraries but not cuda-drivers
      # (recommends are skipped), so the exact 580 driver pin is preserved.
      retry apt-get install -y --no-install-recommends "${CUDA_RUNTIME_PACKAGE}" "${CUDA_DEV_PACKAGES[@]}"

      # nvcc needs a host C/C++ toolchain; install build-essential explicitly (marked
      # manual) so the autoremove later keeps it for a usable dev image.
      retry apt-get install -y --no-install-recommends build-essential

      # Put nvcc + CUDA libraries on PATH for interactive/dev sessions.
      cat >/etc/profile.d/cuda.sh <<'EOF'
      export PATH=/usr/local/cuda-13.0/bin${PATH:+:${PATH}}
      export LD_LIBRARY_PATH=/usr/local/cuda-13.0/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
      EOF
      chmod 0644 /etc/profile.d/cuda.sh

      install -m 0755 -d /usr/share/keyrings
      curl -fsSL --retry 5 --retry-connrefused --retry-delay 2 https://nvidia.github.io/libnvidia-container/gpgkey \
        | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
      curl -fsSL --retry 5 --retry-connrefused --retry-delay 2 https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
        | sed "s#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g" \
        > /etc/apt/sources.list.d/nvidia-container-toolkit.list

      retry apt-get update
      retry apt-get install -y --no-install-recommends nvidia-container-toolkit

      systemctl enable nvidia-modules-load.service
      /usr/local/sbin/load-nvidia-modules.sh || true

      echo "Kernel:" > /root/NVIDIA_OK.txt
      echo "${KVER}" >> /root/NVIDIA_OK.txt
      echo >> /root/NVIDIA_OK.txt
      dpkg -l | egrep "nvidia-driver|nvidia-headless|nvidia-utils|nvidia-dkms|nvidia-container-toolkit" >> /root/NVIDIA_OK.txt || true
      nvidia-ctk --version >> /root/NVIDIA_OK.txt || true
      echo >> /root/NVIDIA_OK.txt
      echo "CUDA runtime:" >> /root/NVIDIA_OK.txt
      dpkg -l "${CUDA_RUNTIME_PACKAGE}" >> /root/NVIDIA_OK.txt || true
      echo >> /root/NVIDIA_OK.txt
      echo "CUDA dev toolkit:" >> /root/NVIDIA_OK.txt
      dpkg -l "${CUDA_DEV_PACKAGES[@]}" >> /root/NVIDIA_OK.txt || true
      /usr/local/cuda-13.0/bin/nvcc --version >> /root/NVIDIA_OK.txt 2>&1 || true

      # Keep only the kernel the NVIDIA module was built for (marked manual and held
      # above). The kernel metapackages are already gone (re-checked here), so a consumer
      # VM's unattended-upgrades cannot install a kernel that lacks the module. Every
      # other kernel is removed, including the one this bake VM is running (the cloud
      # image's kernel: it has no NVIDIA module and carries whatever CVEs the upstream
      # respin has not caught up with yet). linux-check-removal only warns about removing
      # the running kernel under the noninteractive frontend, and nothing after this
      # point loads new modules. Versioned linux-tools packages go too: they are built
      # from the kernel source and the gate reports its CVEs against them.
      CUR_KERNEL="${KVER}"
      KERNEL_METAS="$(installed_kernel_metas)"
      if [ -n "${KERNEL_METAS}" ]; then
        # shellcheck disable=SC2086
        apt-get purge -y ${KERNEL_METAS}
      fi
      OTHER_KERNELS="$(dpkg-query -W -f='${db:Status-Status} ${Package}\n' \
        'linux-image-[0-9]*' 'linux-modules-[0-9]*' 'linux-modules-extra-[0-9]*' \
        'linux-headers-[0-9]*' 'linux-tools-[0-9]*' 'linux-cloud-tools-[0-9]*' 2>/dev/null \
        | awk '$1 == "installed" {print $2}' \
        | grep -vE -- "-${KABI}(-|$)" || true)"
      if [ -n "${OTHER_KERNELS}" ]; then
        # shellcheck disable=SC2086
        apt-get purge -y ${OTHER_KERNELS}
      fi
      if [ "${RUNNING_KERNEL}" != "${CUR_KERNEL}" ]; then
        # The purge leaves the running kernel's module directory behind (depmod output
        # generated after it was installed); drop it so the module check below only
        # sees kernels that are actually installed.
        rm -rf "/lib/modules/${RUNNING_KERNEL}"
      fi

      # Drop the kernel headers/source used to build the NVIDIA module, but keep the
      # C/C++ toolchain (build-essential) so the baked CUDA dev toolkit's nvcc is usable.
      # The DKMS-built NVIDIA module is already in /lib/modules and initramfs; keep
      # dkms/nvidia-dkms installed so purging does not remove the built .ko (kernel is
      # pinned, nothing rebuilds at runtime).
      apt-get purge -y 'linux-headers-*' 'linux-source-*' || true
      apt-get autoremove -y --purge || true
      rm -rf /usr/src/linux-headers-* /usr/src/nvidia-* /var/cache/apt/archives/*.deb
      update-grub || true

      # Fail the bake loudly if any remaining kernel lacks the NVIDIA module (catches skew in CI).
      for K in $(ls -1 /lib/modules); do
        if ! NVIDIA_MODULE_PATH="$(modinfo -k "$K" -n nvidia 2>/dev/null)" \
          || [ ! -f "$NVIDIA_MODULE_PATH" ]; then
          echo "FATAL: no NVIDIA module for kernel $K"
          exit 1
        fi
        echo "NVIDIA module for kernel $K: $NVIDIA_MODULE_PATH"
      done
      echo "Kernels retained: $(ls -1 /lib/modules | tr '\n' ' ')"

      # Fail the bake loudly if the CUDA 13.0 runtime libraries are missing.
      CUDART_PATH="$(find /usr -name 'libcudart.so.13*' -print -quit 2>/dev/null || true)"
      if [ -z "${CUDART_PATH}" ]; then
        echo "FATAL: libcudart.so.13 not found; CUDA 13.0 runtime install failed"
        exit 1
      fi
      echo "CUDA 13.0 runtime OK: ${CUDART_PATH}"

      # Fail the bake loudly if nvcc (CUDA 13.0 dev toolkit) is missing.
      NVCC_PATH="/usr/local/cuda-13.0/bin/nvcc"
      if [ ! -x "${NVCC_PATH}" ]; then
        echo "FATAL: nvcc not found at ${NVCC_PATH}; CUDA 13.0 dev toolkit install failed"
        exit 1
      fi
      echo "CUDA 13.0 dev toolkit OK: $(${NVCC_PATH} --version | awk '/release/ {print}')"

      # Fail the bake loudly if the kernel pin did not take: the target kernel must be
      # installed and bootable, it must be the only kernel left (the cloud image's kernel
      # is gone), and no kernel metapackage may remain to pull another.
      if [ ! -f "/boot/vmlinuz-${CUR_KERNEL}" ] || ! dpkg -s "linux-image-${CUR_KERNEL}" >/dev/null 2>&1; then
        echo "FATAL: target kernel ${CUR_KERNEL} is not installed after the purge"
        exit 1
      fi
      INSTALLED_KERNELS="$(dpkg-query -W -f='${db:Status-Status} ${Package}\n' 'linux-image-[0-9]*' 2>/dev/null \
        | awk '$1 == "installed" {print $2}' | tr '\n' ' ')"
      if [ "${INSTALLED_KERNELS}" != "linux-image-${CUR_KERNEL} " ]; then
        echo "FATAL: expected only linux-image-${CUR_KERNEL} to be installed, found: ${INSTALLED_KERNELS}"
        exit 1
      fi
      LEFTOVER_KERNEL_METAS="$(installed_kernel_metas)"
      if [ -n "${LEFTOVER_KERNEL_METAS}" ]; then
        echo "FATAL: kernel metapackages still installed: ${LEFTOVER_KERNEL_METAS}"
        exit 1
      fi
      echo "Kernel pin OK: ${CUR_KERNEL} held, no other kernel or kernel metapackage installed"

      cloud-init clean --logs
      truncate -s 0 /etc/machine-id
      rm -f /var/lib/dbus/machine-id
      ln -sf /etc/machine-id /var/lib/dbus/machine-id
      apt-get clean
      rm -rf /var/lib/apt/lists/*
      rm -f /etc/apt/apt.conf.d/99bake-lock-timeout

      # Strip the SSH host keys cloud-init generated during this bake boot; they must not
      # ship in a public image. cloud-init's ssh module regenerates them on the first boot
      # of every VM (cloud-init clean above makes that boot a fresh instance).
      rm -f /etc/ssh/ssh_host_*
      if ls /etc/ssh/ssh_host_* >/dev/null 2>&1; then
        echo "FATAL: SSH host keys still present in the image"
        exit 1
      fi

      # Zero free space so deleted clusters compress away and qemu-img convert can drop them.
      dd if=/dev/zero of=/EMPTY bs=1M || true
      rm -f /EMPTY
      fstrim -av || true
      sync
      poweroff

runcmd:
  - [ bash, -lc, "/usr/local/sbin/bootstrap-nvidia.sh | tee -a /var/log/bootstrap-nvidia.log" ]

final_message: "Image bootstrap finished and the system is powering off."
